#!/bin/sh
# Rebuild the site for local testing:   ./build
# Run it after editing a data file (team, alumni, news, season, links...), then refresh your preview.
# First run creates a private Python environment in .venv and installs the build tools.
cd "$(dirname "$0")" || exit 1

if [ ! -x .venv/bin/python ]; then
  echo "Setting up (first run only)..."
  python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt || { echo "Setup failed"; exit 1; }
fi

# macOS Python often can't find certificates; this lets the build fetch the FTC calendar.
[ -f /etc/ssl/cert.pem ] && export SSL_CERT_FILE=/etc/ssl/cert.pem

.venv/bin/python scripts/build.py "$@"
